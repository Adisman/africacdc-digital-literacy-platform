# Africa CDC Digital Literacy Platform — configuration. Copy to .env and fill in. NEVER commit .env.
NODE_ENV=production
BASE_URL=https://learn.example.org
DOMAIN=learn.example.org

# Secrets (generate each with: openssl rand -hex 32). Losing DB_ENCRYPTION_KEY makes personal data unrecoverable — back it up separately.
SESSION_SECRET=
DB_ENCRYPTION_KEY=

# First Africa CDC super-administrator (created on first start, must change password and enrol MFA at first sign-in)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Roles that must use two-step verification (default shown)
MFA_REQUIRED_ROLES=super_admin,ms_admin,facility_admin
